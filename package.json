{
  "name": "hackathon-starter",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install",
    "seed": "npm --prefix backend run seed",
    "dev": "node scripts/dev.js",
    "dev:api": "npm --prefix backend run dev",
    "dev:user": "npm --prefix user run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm --prefix user run build && npm --prefix admin run build",
    "start": "npm --prefix backend start"
  },
  "workspaces": [
    "shared",
    "backend",
    "user",
    "admin"
  ]
}
